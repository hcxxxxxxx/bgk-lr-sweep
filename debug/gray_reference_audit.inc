SUBROUTINE Audit_Record(AUDIT_STEP,MACRO_UPDATE)
! Read-only diagnostics: temporarily substitute moments of current VDF into
! the existing reference residual evaluator, then restore all source fields.
INTEGER, INTENT(IN) :: AUDIT_STEP
REAL(KIND=DBL), INTENT(IN) :: MACRO_UPDATE
REAL(KIND=DBL), ALLOCATABLE :: TSAVE(:,:),XSAVE(:,:),YSAVE(:,:),TK(:,:),XK(:,:),YK(:,:)
REAL(KIND=DBL) :: RC,RO,AC,AO,DC,DOREF,GAP2,NORM2,TEMP2,TEMPNORM,DIFF(NDOF_TRI),VAL(NDOF_TRI)
REAL(KIND=DBL), SAVE :: INITIAL_ABSOLUTE=-1.d0
INTEGER :: AI,AJ1,AJ2,AM
ALLOCATE(TSAVE(NDOF_TRI,N_TRIS),XSAVE(NDOF_TRI,N_TRIS),YSAVE(NDOF_TRI,N_TRIS))
ALLOCATE(TK(NDOF_TRI,N_TRIS),XK(NDOF_TRI,N_TRIS),YK(NDOF_TRI,N_TRIS))
TSAVE=T_s;XSAVE=Qx_s;YSAVE=Qy_s
TK=0.d0;XK=0.d0;YK=0.d0
DO AJ2=1,NAZIM
 DO AJ1=1,NPOLE
  TK=TK+VDF(:,:,AJ1,AJ2)*DOMEGA(AJ1,AJ2)/Cv
  XK=XK+VDF(:,:,AJ1,AJ2)*DOMEGA(AJ1,AJ2)*CX(AJ1,AJ2)
  YK=YK+VDF(:,:,AJ1,AJ2)*DOMEGA(AJ1,AJ2)*CY(AJ1,AJ2)
 END DO
END DO
CALL Update_Diffuse_Adiabatic_Wall_Load()
CALL Calculate_Discrete_Transport_Residual(RC,AC,DC)
T_s=TK;Qx_s=XK;Qy_s=YK
CALL Calculate_Discrete_Transport_Residual(RO,AO,DOREF)
T_s=TSAVE;Qx_s=XSAVE;Qy_s=YSAVE
IF(INITIAL_ABSOLUTE.LT.0.d0) INITIAL_ABSOLUTE=MAX(AO,TINY(1.d0))
GAP2=0.d0;NORM2=0.d0;TEMP2=0.d0;TEMPNORM=0.d0
DO AI=1,N_TRIS
 DIFF=Cv*(TSAVE(:,AI)-TK(:,AI));VAL=Cv*TK(:,AI)
 TEMP2=TEMP2+DOT_PRODUCT(DIFF,MATMUL(INT_NODFUNC_TRI_TRI(:,:,AI),DIFF))
 TEMPNORM=TEMPNORM+DOT_PRODUCT(VAL,MATMUL(INT_NODFUNC_TRI_TRI(:,:,AI),VAL))
 GAP2=GAP2+DOT_PRODUCT(DIFF,MATMUL(INT_NODFUNC_TRI_TRI(:,:,AI),DIFF))
 NORM2=NORM2+DOT_PRODUCT(VAL,MATMUL(INT_NODFUNC_TRI_TRI(:,:,AI),VAL))
 DIFF=(XSAVE(:,AI)-XK(:,AI))/Vg;VAL=XK(:,AI)/Vg
 GAP2=GAP2+DOT_PRODUCT(DIFF,MATMUL(INT_NODFUNC_TRI_TRI(:,:,AI),DIFF))
 NORM2=NORM2+DOT_PRODUCT(VAL,MATMUL(INT_NODFUNC_TRI_TRI(:,:,AI),VAL))
 DIFF=(YSAVE(:,AI)-YK(:,AI))/Vg;VAL=YK(:,AI)/Vg
 GAP2=GAP2+DOT_PRODUCT(DIFF,MATMUL(INT_NODFUNC_TRI_TRI(:,:,AI),DIFF))
 NORM2=NORM2+DOT_PRODUCT(VAL,MATMUL(INT_NODFUNC_TRI_TRI(:,:,AI),VAL))
END DO
WRITE(96,'(I8,10(",",ES24.16))')AUDIT_STEP,MACRO_UPDATE,AO,AC,RO,RC, &
 AO/INITIAL_ABSOLUTE,AC/INITIAL_ABSOLUTE,SQRT(MAX(GAP2,0.d0)/MAX(NORM2,TINY(1.d0))), &
 SQRT(MAX(TEMP2,0.d0)/MAX(TEMPNORM,TINY(1.d0))),INITIAL_ABSOLUTE
FLUSH(96)
WRITE(*,'(A,I6,A,3ES12.4)')'AUDIT step ',AUDIT_STEP,' original/coupled/source-gap ', &
 AO/INITIAL_ABSOLUTE,AC/INITIAL_ABSOLUTE,SQRT(MAX(GAP2,0.d0)/MAX(NORM2,TINY(1.d0)))
IF(AUDIT_STEP.EQ.TMAX .OR. (MACRO_UPDATE.LT.TOL .AND. AUDIT_STEP.GE.AUDIT_MINIMUM))THEN
 OPEN(97,FILE='final_moments.csv',STATUS='REPLACE',ACTION='WRITE')
 WRITE(97,'(A)')'cell,node,kineticT,kineticQx,kineticQy,sourceT,sourceQx,sourceQy'
 DO AI=1,N_TRIS
  DO AM=1,NDOF_TRI
   WRITE(97,'(I8,",",I4,6(",",ES24.16))')AI,AM,TK(AM,AI),XK(AM,AI),YK(AM,AI), &
     TSAVE(AM,AI),XSAVE(AM,AI),YSAVE(AM,AI)
  END DO
 END DO
 CLOSE(97)
END IF
END SUBROUTINE Audit_Record
